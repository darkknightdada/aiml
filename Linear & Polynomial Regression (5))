
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.datasets import fetch_california_housing
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures, StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.pipeline import Pipeline
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
data = fetch_california_housing(as_frame=True)
df = data.frame
print("Dataset Shape:", df.shape)
print("\nFirst 5 Rows:")
print(df.head())
X = df.drop("MedHouseVal", axis=1)
y = df["MedHouseVal"]
X_train, X_test, y_train, y_test = train_test_split(
X,
y,
test_size=0.20,
random_state=42
)
print("\nTraining Data:", X_train.shape)
print("Testing Data :", X_test.shape)
linear_model = LinearRegression()
linear_model.fit(X_train, y_train)
linear_prediction = linear_model.predict(X_test)
linear_mse = mean_squared_error(y_test, linear_prediction)
linear_mae = mean_absolute_error(y_test, linear_prediction)
linear_r2 = r2_score(y_test, linear_prediction)
polynomial_model = Pipeline([
("polynomial", PolynomialFeatures(
degree=2,
include_bias=False
)),
("scaler", StandardScaler()),
("regression", LinearRegression())
])
polynomial_model.fit(X_train, y_train)
polynomial_prediction = polynomial_model.predict(X_test)
polynomial_mse = mean_squared_error(
y_test,
polynomial_prediction
)
polynomial_mae = mean_absolute_error(
y_test,
polynomial_prediction
)
polynomial_r2 = r2_score(
y_test,
polynomial_prediction
)
print("\n" + "=" * 60)
print("MODEL PERFORMANCE")
print("=" * 60)
print("\nLinear Regression")
print("MSE :", round(linear_mse, 4))
print("MAE :", round(linear_mae, 4))
print("R2 Score :", round(linear_r2, 4))
print("\nPolynomial Regression")
print("MSE :", round(polynomial_mse, 4))
print("MAE :", round(polynomial_mae, 4))
print("R2 Score :", round(polynomial_r2, 4))
results = pd.DataFrame({
"Model": [
"Linear Regression",
"Polynomial Regression"
],
"MSE": [
linear_mse,
polynomial_mse
],
"MAE": [
linear_mae,
polynomial_mae
],
"R2 Score": [
linear_r2,
polynomial_r2
]
})
print("\n" + "=" * 60)
print("MODEL COMPARISON")
print("=" * 60)
print(results.to_string(index=False))
results.to_csv(
"regression_results.csv",
index=False
)
# ACTUAL VS PREDICTED GRAPH
plt.figure(figsize=(14, 6))
plt.subplot(1, 2, 1)
plt.scatter(
y_test,
linear_prediction,
color="blue",
alpha=0.4,
s=20
)
plt.plot(
[y_test.min(), y_test.max()],
[y_test.min(), y_test.max()],
color="red",
linewidth=2
)
plt.xlabel("Actual House Value")
plt.ylabel("Predicted House Value")
plt.title("Linear Regression\nActual vs Predicted")
plt.grid(True, alpha=0.3)
plt.subplot(1, 2, 2)
plt.scatter(
y_test,
polynomial_prediction,
color="green",
alpha=0.4,
s=20
)
plt.plot(
[y_test.min(), y_test.max()],
[y_test.min(), y_test.max()],
color="red",
linewidth=2
)
plt.xlabel("Actual House Value")
plt.ylabel("Predicted House Value")
plt.title("Polynomial Regression\nActual vs Predicted")
plt.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig(
"actual_vs_predicted.png",
dpi=300,
bbox_inches="tight"
)
plt.show()
# MODEL METRICS GRAPH
metrics = ["MSE", "MAE", "R2 Score"]
linear_scores = [
linear_mse,
linear_mae,
linear_r2
]
polynomial_scores = [
polynomial_mse,
polynomial_mae,
polynomial_r2
]
x = range(len(metrics))
width = 0.35
plt.figure(figsize=(10, 6))
bars1 = plt.bar(
[i - width / 2 for i in x],
linear_scores,
width=width,
color="royalblue",
label="Linear Regression"
)
bars2 = plt.bar(
[i + width / 2 for i in x],
polynomial_scores,
width=width,
color="orange",
label="Polynomial Regression"
)
plt.xlabel("Evaluation Metrics")
plt.ylabel("Score")
plt.title("Linear Regression vs Polynomial Regression")
plt.xticks(list(x), metrics)
plt.legend()
plt.grid(
axis="y",
linestyle="--",
alpha=0.3
)
for bar in bars1:
plt.text(
bar.get_x() + bar.get_width() / 2,
bar.get_height(),
f"{bar.get_height():.3f}",
ha="center",
va="bottom"
)
for bar in bars2:
plt.text(
bar.get_x() + bar.get_width() / 2,
bar.get_height(),
f"{bar.get_height():.3f}",
ha="center",
va="bottom"
)
plt.tight_layout()
plt.savefig(
"model_metrics_comparison.png",
dpi=300,
bbox_inches="tight"
)
plt.show()
print("\n" + "=" * 60)
print("GRAPH FILES SAVED")
print("=" * 60)
print("1. actual_vs_predicted.png")
print("2. model_metrics_comparison.png")
print("3. regression_results.csv")

